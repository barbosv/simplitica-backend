    {
      "name": "trailing document",
      "raw": "{\"currency\":\"USD\",\"lines\":[{\"quantity\":\"1\",\"unitPrice\":\"1\"}],\"discountAmount\":\"0\",\"taxRatePercent\":\"0\"} {}",
      "error": "invalid_input"
