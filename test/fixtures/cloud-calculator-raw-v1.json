      "name": "unknown field remains invalid",
      "raw": "{\"currency\":\"USD\",\"lines\":[{\"quantity\":\"1\",\"unitPrice\":\"1\"}],\"discountAmount\":\"0\",\"taxRatePercent\":\"0\",\"extra\":true}",
      "error": "invalid_input"
