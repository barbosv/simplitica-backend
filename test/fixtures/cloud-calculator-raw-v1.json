      "error": "invalid_input"
    },
    {
      "name": "UTF8 BOM",
      "raw": "\ufeff{\"currency\":\"USD\",\"lines\":[{\"quantity\":\"1\",\"unitPrice\":\"1\"}],\"discountAmount\":\"0\",\"taxRatePercent\":\"0\"}",
