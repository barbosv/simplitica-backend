    {
      "name": "unpaired Unicode escape",
      "raw": "{\"currency\":\"\\ud800\",\"lines\":[{\"quantity\":\"1\",\"unitPrice\":\"1\"}],\"discountAmount\":\"0\",\"taxRatePercent\":\"0\"}",
      "error": "invalid_input"
    },
    {
      "name": "raw arithmetic overflow preserves code",
      "raw": "{\"currency\":\"USD\",\"lines\":[{\"quantity\":\"999999999\",\"unitPrice\":\"999999999\"}],\"discountAmount\":\"0\",\"taxRatePercent\":\"0\"}",
      "error": "amount_out_of_range"
    }
