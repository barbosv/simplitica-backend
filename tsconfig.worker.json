{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "test/worker/**/*.ts",
    "vitest.worker.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
